+    tree = tmp_path / "wt-tree"
+    tree.mkdir()
+    artifact = tree / "report.md"
+    artifact.write_text("built\n", encoding="utf-8")
+    with kbc.connect() as conn:
+        t = kb.create_task(
+            conn,
+            title="worktree artifact",
+            workspace_kind="worktree",
+            workspace_path=str(tree),
