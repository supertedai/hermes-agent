{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mwp://schemas/ingest-envelope-v1",
  "title": "MWP Hermes Canonical Ingest Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "runtime_path", "plane", "memory_class", "principal_id", "tenant_id", "system_scope", "session_id", "correlation_id", "idempotency_key", "source_ref", "provenance_ref", "observed_at", "operation", "status"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "schema_version": {"const": "mwp.ingest.v1"},
    "runtime_path": {"const": "hermes-agent-engine"},
    "plane": {"enum": ["chat", "user", "system", "agent"]},
    "memory_class": {"type": "string", "minLength": 1},
    "principal_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "system_scope": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string"},
    "cortex_ref": {"type": "string"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": "string"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "writer_ref": {"type": "string"},
    "provenance_ref": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "sensitivity": {"enum": ["public", "private", "sensitive", "restricted"]},
    "operation": {"enum": ["observe", "candidate", "promote", "correct", "tombstone", "handoff", "outcome"]},
    "canonical_authority_ref": {"type": "string"},
    "expected_version": {"type": ["integer", "null"], "minimum": 0},
    "status": {"enum": ["RECEIVED", "VALIDATED", "QUARANTINED", "REJECTED", "ROUTED", "PROJECTED"]}
  }
}
